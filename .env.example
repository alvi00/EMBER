# EMBER — copy to .env.local and fill in ONE provider. Keys stay server-side and are never committed.
# With no key set, EMBER runs in OFFLINE mode (precomputed answers + retrieval-only results).

# google | groq | openai | anthropic
AI_PROVIDER=

# Optional model override for the chosen provider (a sensible default is used when blank)
AI_MODEL=

GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
